# ============================================================
# Question Forge — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider Keys (BYOK — Bring Your Own Key) ---
# At least one is required. The app lets admins pick which to use.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=...

# --- Database ---
DATABASE_URL=postgresql://qforge:qforge_password@localhost:5432/question_forge

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string_in_production

# --- Piston Execution Sandbox ---
PISTON_API_URL=http://localhost:2000

# --- Encryption (for storing API keys in DB) ---
ENCRYPTION_KEY=32_char_hex_string_for_aes_256

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_QUESTIONS_PER_DAY=200

# --- Export ---
EXPORT_SIGNED_URL_EXPIRY_SECONDS=300

# --- OAuth (Enterprise SSO — Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
