# ============================================================
# Question Forge — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider Keys ---
# Server-wide keys. At least one is needed unless every organization adds its own
# key under Admin → LLM Keys (stored encrypted with ENCRYPTION_KEY).
# Configure TWO providers if you can: MCQ / system-design questions are then
# reviewed by a different model than the one that wrote them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Optional model overrides (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-flash-lite-latest

# Review calls (blind solve, adversary, judge, independent code solver) are short and
# frequent. Point them at a cheaper model if you like; unset, they use the model above.
# ANTHROPIC_REVIEW_MODEL=
# OPENAI_REVIEW_MODEL=
# GEMINI_REVIEW_MODEL=

# Cost reporting uses built-in prices for Claude models. For other models, set
# your own rates (USD per million tokens); without them cost is shown as unknown.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# --- Database ---
# Add ?connection_limit=5&pool_timeout=20 for PgBouncer/multi-replica setups
DATABASE_URL=postgresql://qforge:qforge_password@localhost:5432/question_forge

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins (supports multi-tenant / mobile)
CORS_ORIGINS=http://localhost:5173
# Production refuses to boot unless this is 32+ random characters: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Dev-only login shortcut: lets "Authorization: Bearer mock-token" act as the seeded
# admin. Off by default, ignored in production. The frontend needs
# VITE_ALLOW_MOCK_AUTH=true as well. Otherwise log in with the seeded account.
ALLOW_MOCK_AUTH=false

# --- Redis (Job Queue, Rate Limiting, Caching) ---
REDIS_URL=redis://localhost:6379

# --- Code Execution Sandbox ---
# piston (default): isolated Piston container. Needs the python, java, gcc (cpp),
#   node and sqlite3 runtimes installed in it.
# local: runs generated code as plain processes on THIS machine with NO isolation.
#   For development/tests without Docker only; refused when NODE_ENV=production.
SANDBOX_DRIVER=piston
PISTON_API_URL=http://localhost:2000

# --- Validation tuning ---
# Random inputs generated per coding question (small / edge).
VALIDATION_RANDOM_CASES=12
VALIDATION_EDGE_CASES=4
# MEDIUM/HARD coding questions fail unless brute force is clearly slower than the
# optimal solution on a max-size input. Set to false to only record the result.
VALIDATION_ENFORCE_COMPLEXITY_GAP=true
# Coding questions: have a second model solve the problem from the statement alone and
# run its program against the verified test cases. Catches statements that the reference
# solutions do not actually match. Costs one extra LLM call per coding question.
VALIDATION_BLIND_SOLVER=true

# --- Worker Concurrency (tune based on instance size) ---
# WORKER_CONCURRENCY: how many questions are generated/validated in parallel
# (each question is its own job)
WORKER_CONCURRENCY=5
# SANDBOX_CONCURRENCY: max simultaneous Piston calls during validation
SANDBOX_CONCURRENCY=10

# --- Encryption (webhook secrets and per-organization LLM keys, AES-256-GCM) ---
# 64 hex characters: openssl rand -hex 32
# Changing it makes previously stored secrets unreadable.
ENCRYPTION_KEY=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Generation requests per minute per signed-in user
GENERATE_RATE_LIMIT_PER_MIN=5
# The per-organization daily quota lives in the database (Organization.maxQuestionsPerDay, default 200).

# --- Export Storage ---
# With S3 configured, exports are uploaded and served through presigned URLs.
# Without S3: in development exports go to EXPORT_LOCAL_DIR automatically; in
# production you must opt in with EXPORT_STORAGE=local (single-machine only —
# files on one replica's disk are not visible to the others).
# EXPORT_STORAGE=local
# EXPORT_LOCAL_DIR=.exports
EXPORT_SIGNED_URL_EXPIRY_SECONDS=300
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Housekeeping (runs in the worker) ---
# Every MAINTENANCE_INTERVAL_MINUTES: re-queue generation items that have had no progress
# for STALE_ITEM_MINUTES and no queue job, and delete expired local export files.
MAINTENANCE_INTERVAL_MINUTES=5
STALE_ITEM_MINUTES=15

# --- Platform operators ---
# Comma-separated emails allowed to create new organizations (POST /api/admin/organizations).
# Empty = nobody can.
SUPERADMIN_EMAILS=

# --- Webhooks ---
# Webhook URLs must resolve to public addresses. Set to true ONLY while developing
# to deliver to localhost; ignored in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
