// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum QuestionType {
  DSA
  OOPS
  SYSTEM_DESIGN
  SQL
  CONCEPTUAL
  MCQ
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  VALIDATING
  VALIDATED
  IN_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum UserRole {
  ADMIN
  REVIEWER
  GENERATOR
}

enum ExportFormat {
  JSON
  PDF_CANDIDATE
  PDF_INTERNAL
}

enum ActionType {
  QUESTION_GENERATED
  QUESTION_VIEWED
  QUESTION_EDITED
  QUESTION_APPROVED
  QUESTION_REJECTED
  PAPER_EXPORTED
  USER_LOGIN
  USER_LOGOUT
  API_KEY_UPDATED
  WEBHOOK_TRIGGERED
  QUESTION_REVALIDATED
  USER_CREATED
  USER_UPDATED
  PASSWORD_CHANGED
}

enum GenerationKind {
  GENERATE         // draft a brand-new question, then validate it
  COMPLETE_IMPORT  // write solutions + tests for an imported DRAFT statement, then validate
  REVALIDATE       // re-run validation on an edited question (no LLM drafting)
}

enum GenerationItemStatus {
  QUEUED
  GENERATING
  VALIDATING
  VALIDATED
  FAILED
}

// ===== MODELS =====

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  llmApiKeysEncrypted  Json?     // Encrypted BYOK keys stored per org
  maxQuestionsPerDay   Int       @default(200)
  webhookUrl           String?
  webhookSecret        String?   // AES-256-GCM ciphertext (enc:v1:...), see apps/api/src/utils/crypto.ts
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users     User[]
  questions Question[]
  papers    Paper[]
  auditLogs AuditLog[]
  generationBatches GenerationBatch[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  role           UserRole @default(REVIEWER)
  passwordHash   String?  // null if SSO-only
  ssoProvider    String?  // "google" | "microsoft"
  ssoId          String?
  isActive       Boolean  @default(true) // false = deactivated: cannot log in, existing tokens are rejected
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  reviews      QuestionReview[]
  auditLogs    AuditLog[]

  @@unique([ssoProvider, ssoId])
}

model Question {
  id              String         @id @default(cuid())
  type            QuestionType
  difficulty      Difficulty
  topic           String
  title           String
  statement       String         @db.Text
  options         Json?          // For MCQ-style OOPS questions
  answer          String?        @db.Text
  explanation     String?        @db.Text
  optimalSolution    Json?          // { python: "...", java: "...", cpp: "...", javascript: "..." }
  bruteForceSolution Json?          // { python: "...", java: "...", cpp: "...", javascript: "..." }
  testCases       Json?          // Array of { input, expectedOutput }
  languages       String[]       // Supported languages for DSA
  tags            String[]
  sourceUrl       String?        // If scraped from LeetCode/GFG
  sourcePlatform  String?        // "leetcode" | "gfg" | "generated"
  status          QuestionStatus @default(DRAFT)
  validationResult Json?         // Result from sandbox execution
  validationAssets Json?         // Inputs validation needs again on re-run: { inputGenerator, sqlDdl, sqlDatasets, rubric }
  embeddingVector Float[]        // 256-dim lexical feature-hash vector, compared in application code
  version         Int            @default(1)
  retryCount      Int            @default(0)
  organizationId  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  history      QuestionHistory[]
  reviews      QuestionReview[]
  papers       PaperQuestion[]

  // Composite indexes for the most common filtered queries
  // (status-filtered review queue, type+difficulty generation reports, time-series feeds)
  @@index([organizationId, status])
  @@index([organizationId, type, difficulty])
  @@index([organizationId, createdAt])
}

model QuestionHistory {
  id         String   @id @default(cuid())
  questionId String
  version    Int
  snapshot   Json     // Full question snapshot at this version
  editedById String?
  editNote   String?
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
}

model QuestionReview {
  id         String   @id @default(cuid())
  questionId String
  reviewerId String
  decision   String   // "APPROVED" | "REJECTED"
  note       String?
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  reviewer User     @relation(fields: [reviewerId], references: [id])
}

model Paper {
  id             String   @id @default(cuid())
  title          String
  organizationId String
  config         Json     // The wizard config used to generate this paper
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  questions    PaperQuestion[]
  exports      ExportRecord[]
}

model PaperQuestion {
  id         String @id @default(cuid())
  paperId    String
  questionId String
  order      Int

  paper    Paper    @relation(fields: [paperId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([paperId, questionId])
}

model ExportRecord {
  id          String       @id @default(cuid())
  paperId     String
  format      ExportFormat
  exportedById String
  signedToken String?      @unique // For ephemeral URL
  storageKey  String?      // Local-disk file name when S3 is not configured
  expiresAt   DateTime?
  downloadedAt DateTime?
  createdAt   DateTime     @default(now())

  paper Paper @relation(fields: [paperId], references: [id])
}

// One row per "Generate" click (or per re-validation / import-completion request).
// Its id doubles as the public jobId.
model GenerationBatch {
  id             String         @id
  organizationId String
  requestedById  String
  kind           GenerationKind @default(GENERATE)
  config         Json
  paperId        String?
  total          Int
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?
  cancelledAt    DateTime?      // set when a user cancels: queued items are dropped, running ones finish

  organization Organization     @relation(fields: [organizationId], references: [id])
  items        GenerationItem[]

  @@index([organizationId, createdAt])
}

// One row per question slot. Each item is its own BullMQ job, so a crash or retry
// only ever repeats that one question.
model GenerationItem {
  id            String               @id @default(cuid())
  batchId       String
  index         Int
  type          QuestionType
  difficulty    Difficulty
  topic         String?
  status        GenerationItemStatus @default(QUEUED)
  stage         String?              // Human-readable current step, shown live in the UI
  attempts      Int                  @default(0)
  failureReason String?              @db.Text
  questionId    String?
  inputTokens   Int                  @default(0)
  outputTokens  Int                  @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt // last progress; the sweeper uses it to spot stuck items

  batch GenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, index])
  @@index([questionId])
}

model AuditLog {
  id             String     @id @default(cuid())
  organizationId String
  userId         String?
  action         ActionType
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  // Indexes for audit log pagination and action filtering
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}
